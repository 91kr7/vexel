{
  "name": "client",
  "private": true,
  "//version": "Deliberately left at 0.0.0 and never bumped: this package is private and never published, and the running version of the product is declared once, by the repository root package.json. One place to bump means two version strings in this repository can never disagree about which build is running.",
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Christian Mariani",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm run lint:ui-boundary",
    "lint:ui-boundary": "node scripts/check-ui-conformance.mjs",
    "test": "npm run test:typecheck && npm run lint:ui-boundary && npm run test:unit",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "vitest run --reporter=dot",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
