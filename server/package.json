{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --experimental-test-module-mocks --import tsx --test-reporter=dot --test \"test/unit/**/*.test.ts\"",
    "test:api": "node --experimental-test-module-mocks --import tsx --test-reporter=dot --test \"test/api/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
